# ─────────────────────────────────────────────
# IMPERIUM LUX SPA – Variables de Entorno
# Copia este archivo como .env y completa los valores
# ─────────────────────────────────────────────

# EmailJS – https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Correo donde llegan las reservas
VITE_CLINIC_EMAIL=

# Supabase – https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para el servidor (api/create-staff.js) — NUNCA lleva prefijo VITE_,
# así nunca se empaqueta en el frontend. Agrégala directo en Vercel
# (Project Settings > Environment Variables), no en este archivo si vas a
# subir el repo a un lugar compartido.
# Supabase > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
